# ---- Supabase (server + web) ----
# Local ports come from supabase/config.toml (offset from the CLI defaults so this
# stack can run alongside another local Supabase project). `supabase status` prints them.
SUPABASE_URL=http://127.0.0.1:55321
# Despite the legacy variable names, use Supabase's current publishable and
# server-only secret keys (`sb_publishable_...` / `sb_secret_...`). Legacy
# anon/service_role JWT keys remain compatible.
SUPABASE_ANON_KEY=sb_publishable_replace-me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me
# Optional: legacy HS256 JWT secret (only needed for projects that still issue HS256 tokens).
# Tokens signed with ES256/RS256 are always verified via the project's JWKS endpoint.
SUPABASE_JWT_SECRET=

# ---- Server ----
# Set to production to require HTTPS origins and a strong webhook secret at startup.
SINDRAL_ENV=development
PORT=8787
HOST=0.0.0.0
# Public origin of the UI (used for CORS). Comma separated for multiple.
WEB_ORIGIN=http://localhost:5173
# 32-byte key, hex encoded (openssl rand -hex 32). Encrypts provider tokens at rest.
SECRETS_ENCRYPTION_KEY=
# GitHub webhook secret for PR comment ingestion.
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth App used only to authorize repository access after Supabase login.
# Register this exact callback URL in the OAuth App settings.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/github/callback
# Preferred production credentials. The private key may contain escaped newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# JSON object mapping Sindral user UUIDs to GitHub App installation IDs.
GITHUB_APP_INSTALLATIONS=
# Bearer token protecting /api/metrics (32+ characters in production).
METRICS_TOKEN=
# Emergency controls. Dispatch pauses new worker leases; merge must be explicitly enabled.
SINDRAL_JOB_DISPATCH_ENABLED=true
SINDRAL_AUTO_MERGE_ENABLED=false
LOG_LEVEL=info

# ---- Web (Vite) ----
VITE_SUPABASE_URL=http://127.0.0.1:55321
# Browser-safe publishable key only. Never put the secret key in a VITE_* value.
VITE_SUPABASE_ANON_KEY=sb_publishable_replace-me
VITE_API_URL=http://localhost:8787

# ---- Worker ----
SINDRAL_SERVER_URL=http://localhost:8787
SINDRAL_WORKER_KEY=
SINDRAL_WORKDIR=~/.sindral
SINDRAL_CONCURRENCY=2
SINDRAL_WORKER_NAME=
# Extra PATH entries for supervisor-launched workers that do not load shell profiles.
SINDRAL_EXTRA_PATH=
SINDRAL_RETENTION_DAYS=7
SINDRAL_ALLOW_PAT_MERGE=false
