{
  "name": "sindral-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:vercel": "pnpm --filter @sindral/server... build && pnpm --filter @sindral/web build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "dev": "pnpm -r --parallel --filter ./apps/server --filter ./apps/web run dev",
    "dev:server": "pnpm --filter @sindral/server dev",
    "dev:web": "pnpm --filter @sindral/web dev",
    "dev:worker": "pnpm --filter @sindral/worker dev",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test",
    "lint": "pnpm -r run lint && eslint e2e scripts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "smoke": "node scripts/smoke.mjs",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "release:worker": "pnpm --filter @sindral/shared build && pnpm --filter @sindral/worker build && node scripts/package-worker.mjs release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
