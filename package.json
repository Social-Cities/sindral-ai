{
  "name": "sindral-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "dev": "pnpm -r --parallel --filter ./apps/server --filter ./apps/web run dev",
    "dev:server": "pnpm --filter @sindral/server dev",
    "dev:web": "pnpm --filter @sindral/web dev",
    "dev:worker": "pnpm --filter @sindral/worker dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.43.0",
    "@eslint/js": "^9.35.0",
    "globals": "^16.3.0"
  },
  "type": "module"
}
